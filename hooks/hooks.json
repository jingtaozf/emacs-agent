{
  "description": "Emacs Claude Agent hooks — permission handling + CLI session persistence",
  "hooks": {
    "SessionStart": [{
      "hooks": [{
        "type": "command",
        "command": "uv run --project ${CLAUDE_PLUGIN_ROOT}/python workspace-bridge session-start",
        "timeout": 10
      }]
    }],
    "PreToolUse": [{
      "matcher": "AskUserQuestion",
      "hooks": [{
        "type": "command",
        "command": "uv run --project ${CLAUDE_PLUGIN_ROOT}/python workspace-bridge permission",
        "timeout": 5
      }]
    }],
    "PostToolUse": [{
      "matcher": "AskUserQuestion",
      "hooks": [{
        "type": "command",
        "command": "uv run --project ${CLAUDE_PLUGIN_ROOT}/python workspace-bridge permission-clear",
        "timeout": 5
      }]
    }]
  }
}
