{
  "description": "Emacs Claude Agent hooks — permission handling only",
  "hooks": {
    "PreToolUse": [{
      "matcher": "AskUserQuestion|ExitPlanMode",
      "hooks": [{
        "type": "command",
        "command": "uv run --project ${CLAUDE_PLUGIN_ROOT}/python workspace-bridge permission",
        "timeout": 5
      }]
    }],
    "PostToolUse": [{
      "matcher": "AskUserQuestion|ExitPlanMode",
      "hooks": [{
        "type": "command",
        "command": "uv run --project ${CLAUDE_PLUGIN_ROOT}/python workspace-bridge permission-clear",
        "timeout": 5
      }]
    }]
  }
}
