{
  "description": "Emacs Claude Agent hooks for SDD bridge",
  "hooks": {
    "UserPromptSubmit": [{
      "hooks": [{
        "type": "command",
        "command": "uv run --project ${CLAUDE_PLUGIN_ROOT}/python sdd-bridge prompt",
        "timeout": 10
      }]
    }],
    "PostToolUse": [{
      "matcher": "TodoWrite",
      "hooks": [{
        "type": "command",
        "command": "uv run --project ${CLAUDE_PLUGIN_ROOT}/python sdd-bridge tool",
        "timeout": 5
      }]
    }],
    "Stop": [{
      "hooks": [{
        "type": "command",
        "command": "uv run --project ${CLAUDE_PLUGIN_ROOT}/python sdd-bridge response",
        "timeout": 10
      }]
    }]
  }
}
