{
  "description": "Emacs Claude Agent hooks for SDD bridge",
  "hooks": {
    "UserPromptSubmit": [{
      "hooks": [{
        "type": "command",
        "command": "bash ${CLAUDE_PLUGIN_ROOT}/scripts/sdd-bridge.sh prompt",
        "timeout": 10
      }]
    }],
    "Stop": [{
      "hooks": [{
        "type": "command",
        "command": "bash ${CLAUDE_PLUGIN_ROOT}/scripts/sdd-bridge.sh response",
        "timeout": 10
      }]
    }]
  }
}
