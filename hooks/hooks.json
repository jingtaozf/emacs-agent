{
  "description": "Emacs Claude Agent hooks for workspace bridge",
  "hooks": {
    "SessionStart": [{
      "hooks": [{
        "type": "command",
        "command": "uv run --project ${CLAUDE_PLUGIN_ROOT}/python workspace-bridge session-start",
        "timeout": 5
      }]
    }],
    "UserPromptSubmit": [{
      "hooks": [{
        "type": "command",
        "command": "uv run --project ${CLAUDE_PLUGIN_ROOT}/python workspace-bridge prompt",
        "timeout": 10
      }]
    }],
    "PreToolUse": [{
      "hooks": [{
        "type": "command",
        "command": "uv run --project ${CLAUDE_PLUGIN_ROOT}/python workspace-bridge permission",
        "timeout": 5
      }]
    }],
    "PostToolUse": [
      {
        "matcher": "TodoWrite",
        "hooks": [{
          "type": "command",
          "command": "uv run --project ${CLAUDE_PLUGIN_ROOT}/python workspace-bridge tool",
          "timeout": 5
        }]
      },
      {
        "hooks": [{
          "type": "command",
          "command": "uv run --project ${CLAUDE_PLUGIN_ROOT}/python workspace-bridge permission-clear",
          "timeout": 5
        }]
      }
    ],
    "Stop": [{
      "hooks": [{
        "type": "command",
        "command": "uv run --project ${CLAUDE_PLUGIN_ROOT}/python workspace-bridge response",
        "timeout": 10
      }]
    }]
  }
}
