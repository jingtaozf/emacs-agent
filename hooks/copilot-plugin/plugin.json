{
  "name": "emacs-workspace-bridge",
  "version": "1.0.0",
  "description": "Emacs Claude Agent workspace bridge hooks for GitHub Copilot CLI",
  "hooks": {
    "sessionStart": [{
      "bash": "uv run --project ${CLAUDE_PLUGIN_ROOT}/python workspace-bridge session-start",
      "timeoutSec": 5
    }],
    "userPromptSubmitted": [{
      "bash": "uv run --project ${CLAUDE_PLUGIN_ROOT}/python workspace-bridge prompt",
      "timeoutSec": 10
    }],
    "preToolUse": [{
      "bash": "uv run --project ${CLAUDE_PLUGIN_ROOT}/python workspace-bridge permission",
      "timeoutSec": 5
    }],
    "postToolUse": [{
      "matcher": "TodoWrite",
      "bash": "uv run --project ${CLAUDE_PLUGIN_ROOT}/python workspace-bridge tool",
      "timeoutSec": 5
    }, {
      "bash": "uv run --project ${CLAUDE_PLUGIN_ROOT}/python workspace-bridge permission-clear",
      "timeoutSec": 5
    }],
    "sessionEnd": [{
      "bash": "uv run --project ${CLAUDE_PLUGIN_ROOT}/python workspace-bridge response",
      "timeoutSec": 10
    }]
  }
}
