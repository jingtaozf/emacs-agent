FROM oven/bun:latest

# Layer 1: System dependencies (cached unless Dockerfile changes)
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
    git curl ca-certificates openssh-client make emacs-nox socat && \
    rm -rf /var/lib/apt/lists/*

# Layer 2: Emacs test dependencies - literate-elisp
RUN mkdir -p /root/projects && \
    git clone --depth 1 https://github.com/jingtaozf/literate-elisp.git /root/projects/literate-elisp

# Layer 3: Emacs test dependencies - web-server
RUN mkdir -p /root/.emacs.d/straight/build/web-server && \
    curl -sL https://raw.githubusercontent.com/eschulte/emacs-web-server/master/web-server.el \
         -o /root/.emacs.d/straight/build/web-server/web-server.el && \
    curl -sL https://raw.githubusercontent.com/eschulte/emacs-web-server/master/web-server-status-codes.el \
         -o /root/.emacs.d/straight/build/web-server/web-server-status-codes.el

# Layer 4: Claude Code (cached until explicit rebuild)
RUN bun install -g @anthropic-ai/claude-code@latest

WORKDIR /workspace

# Runtime entrypoint for dynamic configuration
COPY entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

ENTRYPOINT ["/entrypoint.sh"]
