# Auto-generated by `claude plugin` CLI — per-machine state, not portable.
/.claude/settings.json
/.cache/

# LP build artefacts (regenerated by literate-agent scripts)
*.lock

# Scratch / draft docs (not for commit — cloned refs, WIP research, etc.)
/docs/draft/
/research/
/workspace-hooks.json

# Cron-driven refactor loop runtime state (per-machine)
.refactor-cron-id
.refactor-cron-counter

# machine-local: shared LP rules symlinked from ~/projects/literate-agent
.claude/rules/literate-agent
/.agent/
