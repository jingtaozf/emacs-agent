# Emacs
*~
\#*\#
.\#*
*.elc
auto-save-list

 Backup files
*.bak
*.orig

# Diff files
*.diff
*.patch

# OS files
.DS_Store
Thumbs.db

# MCP config (contains dynamic Docker host IP)
.mcp.json
flycheck_*
/.test-results/
/.claude/skills/emacs-agent/
